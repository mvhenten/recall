{
  "name": "recall",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:browser": "node npm-scripts/build-browser.mjs",
    "prepare": "npm run build:browser",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p browser",
    "pretypecheck": "npm run build:browser",
    "fix": "biome check --write .",
    "pretest": "npm run build:browser",
    "test": "vitest run && node --test --test-timeout=10000 hooks/*.test.mjs",
    "predeploy": "npm run build:browser",
    "deploy": "node npm-scripts/deploy.mjs",
    "presetup": "npm run build:browser",
    "setup": "node npm-scripts/setup.mjs",
    "release": "node npm-scripts/release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.0",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261001.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "jose": "^6.2.14",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.150.0"
  },
  "allowScripts": {
    "workerd@1.20261023.1": true,
    "esbuild@0.28.2": true,
    "sharp@0.35.5": true
  },
  "license": "MIT",
  "dependencies": {
    "zod": "^4.6.6"
  }
}
