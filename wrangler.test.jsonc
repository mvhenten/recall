{
  "name": "recall-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "recall", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "recall-artifacts" },
    { "binding": "TRANSCRIPTS", "bucket_name": "recall-transcripts" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "MAILBOX", "class_name": "Mailbox" }, { "name": "TENANT", "class_name": "Tenant" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Mailbox"] }, { "tag": "v2", "new_sqlite_classes": ["Tenant"] }],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }]
}
