{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recall",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "queues": {
    "consumers": [
      {
        "queue": "recall-transcripts",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 20,
        // A redelivery waits a minute, so the twenty a message gets span twenty minutes of a
        // dependency that keeps failing rather than the second or two it takes to burn them
        // back-to-back and land in a dead letter queue nothing reads.
        "retry_delay": 60,
        "dead_letter_queue": "recall-transcripts-dead"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "recall",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "MAILBOX", "class_name": "Mailbox" }, { "name": "TENANT", "class_name": "Tenant" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Mailbox"] }, { "tag": "v2", "new_sqlite_classes": ["Tenant"] }],
  // A tenant's schema is a file of SQL, bundled as the text it holds.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }]
}
