{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recall.json",
  "$defs": {
    "AppendRecords": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "AppendRecords.json",
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "TranscriptLine.json"
          },
          "minItems": 1,
          "maxItems": 1000
        }
      },
      "required": ["file", "from", "records"]
    },
    "TranscriptLine": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "TranscriptLine.json",
      "type": "string",
      "minLength": 1
    },
    "RecordsAccepted": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RecordsAccepted.json",
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "next": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": ["file", "next"]
    },
    "RecordsConflict": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RecordsConflict.json",
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "minLength": 1
        },
        "next": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": ["error", "next"]
    },
    "SessionFocus": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SessionFocus.json",
      "type": "object",
      "properties": {
        "first": {
          "type": "string",
          "maxLength": 200
        },
        "latest": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": ["first", "latest"]
    },
    "SessionSync": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SessionSync.json",
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "cwd": {
          "type": "string",
          "maxLength": 500
        },
        "repo": {
          "type": "string",
          "maxLength": 500
        },
        "branch": {
          "type": "string",
          "maxLength": 500
        },
        "commit": {
          "type": "string",
          "maxLength": 500
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastActivityAt": {
          "type": "string",
          "format": "date-time"
        },
        "prompts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "focus": {
          "$ref": "SessionFocus.json"
        },
        "mode": {
          "$ref": "SessionMode.json"
        },
        "permissionMode": {
          "type": "string",
          "maxLength": 500
        },
        "pid": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "host",
        "cwd",
        "repo",
        "branch",
        "commit",
        "startedAt",
        "lastActivityAt",
        "prompts",
        "focus",
        "mode",
        "permissionMode",
        "pid"
      ]
    },
    "SessionMode": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SessionMode.json",
      "type": "string",
      "enum": ["Interactive", "Headless", "Unknown"]
    },
    "UsageDelta": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "UsageDelta.json",
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "repo": {
          "type": "string",
          "maxLength": 500
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "account": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "prompts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "inputTokens": {
          "type": "string",
          "minimum": 0,
          "maximum": 1000000000
        },
        "outputTokens": {
          "type": "string",
          "minimum": 0,
          "maximum": 1000000000
        },
        "cacheWriteTokens": {
          "type": "string",
          "minimum": 0,
          "maximum": 1000000000
        },
        "cacheReadTokens": {
          "type": "string",
          "minimum": 0,
          "maximum": 1000000000
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "durable": {
          "type": "boolean"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 500
        }
      },
      "required": [
        "seq",
        "host",
        "repo",
        "provider",
        "account",
        "model",
        "prompts",
        "inputTokens",
        "outputTokens",
        "cacheWriteTokens",
        "cacheReadTokens",
        "at",
        "durable",
        "files"
      ]
    },
    "Device": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "Device.json",
      "type": "object",
      "properties": {
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "maxLength": 500
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "hostLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string"
        },
        "lastUsedAt": {
          "type": "string"
        },
        "current": {
          "type": "boolean"
        }
      },
      "required": ["deviceId", "name", "host", "hostLabel", "createdAt", "lastUsedAt", "current"]
    },
    "Session": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "Session.json",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "maxLength": 500
        },
        "agentName": {
          "type": "string",
          "maxLength": 500
        },
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "maxLength": 500
        },
        "hostLabel": {
          "type": "string",
          "maxLength": 500
        },
        "cwd": {
          "type": "string",
          "maxLength": 500
        },
        "repo": {
          "type": "string",
          "maxLength": 500
        },
        "branch": {
          "type": "string",
          "maxLength": 500
        },
        "commit": {
          "type": "string",
          "maxLength": 500
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastActivityAt": {
          "type": "string",
          "format": "date-time"
        },
        "prompts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "focus": {
          "$ref": "SessionFocus.json"
        },
        "mode": {
          "$ref": "SessionMode.json"
        },
        "permissionMode": {
          "type": "string",
          "maxLength": 500
        },
        "pid": {
          "type": "integer",
          "minimum": 0
        },
        "current": {
          "type": "boolean"
        }
      },
      "required": [
        "sessionId",
        "name",
        "agentName",
        "deviceId",
        "host",
        "hostLabel",
        "cwd",
        "repo",
        "branch",
        "commit",
        "startedAt",
        "lastActivityAt",
        "prompts",
        "focus",
        "mode",
        "permissionMode",
        "pid",
        "current"
      ]
    },
    "PastSession": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "PastSession.json",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "maxLength": 500
        },
        "agentName": {
          "type": "string",
          "maxLength": 500
        },
        "host": {
          "type": "string",
          "maxLength": 500
        },
        "hostLabel": {
          "type": "string",
          "maxLength": 500
        },
        "cwd": {
          "type": "string",
          "maxLength": 500
        },
        "repo": {
          "type": "string",
          "maxLength": 500
        },
        "branch": {
          "type": "string",
          "maxLength": 500
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastActivityAt": {
          "type": "string",
          "format": "date-time"
        },
        "prompts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "focus": {
          "$ref": "SessionFocus.json"
        },
        "running": {
          "type": "boolean"
        }
      },
      "required": [
        "sessionId",
        "name",
        "agentName",
        "host",
        "hostLabel",
        "cwd",
        "repo",
        "branch",
        "startedAt",
        "lastActivityAt",
        "prompts",
        "focus",
        "running"
      ]
    },
    "SessionExcerpt": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SessionExcerpt.json",
      "type": "object",
      "properties": {
        "speaker": {
          "anyOf": [
            {
              "type": "string",
              "const": "user"
            },
            {
              "type": "string",
              "const": "model"
            }
          ]
        },
        "text": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["speaker", "text", "at"]
    },
    "SessionHit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SessionHit.json",
      "type": "object",
      "properties": {
        "session": {
          "$ref": "PastSession.json"
        },
        "score": {
          "type": "number"
        },
        "excerpt": {
          "$ref": "SessionExcerpt.json"
        }
      },
      "required": ["session", "score", "excerpt"]
    },
    "MessageAddress": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "MessageAddress.json",
      "type": "object",
      "properties": {
        "scope": {
          "anyOf": [
            {
              "type": "string",
              "const": "host"
            },
            {
              "type": "string",
              "const": "session"
            }
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["scope", "target"]
    },
    "SendMessage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SendMessage.json",
      "type": "object",
      "properties": {
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "const": "news"
            },
            {
              "type": "string",
              "const": "order"
            }
          ]
        },
        "address": {
          "$ref": "MessageAddress.json"
        },
        "fromSessionId": {
          "type": "string"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        }
      },
      "required": ["kind", "address", "fromSessionId", "body"]
    },
    "MemoryPath": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "MemoryPath.json",
      "type": "object",
      "properties": {
        "memoryName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      },
      "required": ["memoryName"]
    },
    "Memory": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "Memory.json",
      "type": "object",
      "properties": {
        "memoryId": {
          "type": "string",
          "minLength": 1
        },
        "userId": {
          "type": "string",
          "minLength": 1
        },
        "memoryName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "type": {
          "$ref": "MemoryType.json"
        },
        "body": {
          "type": "string",
          "maxLength": 100000
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "MemoryTag.json"
          },
          "maxItems": 50
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "recallCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "memoryId",
        "userId",
        "memoryName",
        "description",
        "type",
        "body",
        "tags",
        "createdAt",
        "updatedAt",
        "recallCount"
      ]
    },
    "MemoryType": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "MemoryType.json",
      "type": "string",
      "enum": ["User", "Feedback", "Project", "Reference"]
    },
    "MemoryTag": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "MemoryTag.json",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[a-z0-9][a-z0-9._:/-]*$"
    },
    "SaveMemory": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SaveMemory.json",
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "type": {
          "$ref": "MemoryType.json"
        },
        "body": {
          "type": "string",
          "maxLength": 100000
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "MemoryTag.json"
          },
          "maxItems": 50
        }
      },
      "required": ["description", "type", "body", "tags"]
    },
    "SearchMemories": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SearchMemories.json",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "MemoryTag.json"
          },
          "maxItems": 50
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "minScore": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "mode": {
          "$ref": "SearchMode.json"
        }
      },
      "required": ["query", "tags", "limit", "minScore", "mode"]
    },
    "SearchMode": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SearchMode.json",
      "type": "string",
      "enum": ["Hybrid", "Vector", "Text"]
    },
    "MemoryHit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "MemoryHit.json",
      "type": "object",
      "properties": {
        "memory": {
          "$ref": "Memory.json"
        },
        "score": {
          "type": "number"
        }
      },
      "required": ["memory", "score"]
    },
    "NearbyMemory": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "NearbyMemory.json",
      "type": "object",
      "properties": {
        "score": {
          "type": "number"
        },
        "memoryName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "type": {
          "$ref": "MemoryType.json"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "MemoryTag.json"
          },
          "maxItems": 50
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": ["score", "memoryName", "type", "tags", "description"]
    }
  }
}
