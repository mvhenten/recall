{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recall.json",
  "$defs": {
    "AppendRecords": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "AppendRecords.json",
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "TranscriptLine.json"
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "closed": {
          "type": "boolean",
          "description": "Whether a line break closes the last record this append carries. Records join with one break\nbetween them and a file is the records of it laid out that way, so the break that ends the\nfile is the one thing no ordinal says: a transcript always ends on one, and a tool output the\nsession stopped writing part way through a line does not."
        }
      },
      "required": ["file", "from", "records", "closed"]
    },
    "TranscriptLine": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "TranscriptLine.json",
      "type": "string",
      "minLength": 1,
      "description": "One line of a transcript file, redacted, under the ordinal it holds in that file. A line that is\nnot valid UTF-8 would cross as a JSON string lossily, so it is carried as the marker\n`\\u0000base64:` and the line's own bytes in base64; the archive decodes it back and holds the\nbytes the host read. A line that is valid UTF-8 and opens with that marker is carried the same\nway, which is what makes reading one unambiguous."
    },
    "RecordsAccepted": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RecordsAccepted.json",
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "next": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": ["file", "next"]
    },
    "RecordsConflict": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RecordsConflict.json",
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "minLength": 1
        },
        "next": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": ["error", "next"]
    },
    "SessionFocus": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SessionFocus.json",
      "type": "object",
      "properties": {
        "first": {
          "$ref": "FocusText.json"
        },
        "latest": {
          "$ref": "FocusText.json"
        }
      },
      "required": ["first", "latest"]
    },
    "FocusText": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "FocusText.json",
      "type": "string",
      "maxLength": 200
    },
    "SessionSync": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SessionSync.json",
      "type": "object",
      "properties": {
        "host": {
          "$ref": "SessionText.json",
          "minLength": 1
        },
        "cwd": {
          "$ref": "SessionText.json"
        },
        "repo": {
          "$ref": "SessionText.json"
        },
        "branch": {
          "$ref": "SessionText.json"
        },
        "commit": {
          "$ref": "SessionText.json"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastActivityAt": {
          "type": "string",
          "format": "date-time"
        },
        "prompts": {
          "$ref": "PromptCount.json"
        },
        "focus": {
          "$ref": "SessionFocus.json"
        },
        "mode": {
          "$ref": "SessionMode.json"
        },
        "permissionMode": {
          "$ref": "SessionText.json"
        },
        "pid": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "host",
        "cwd",
        "repo",
        "branch",
        "commit",
        "startedAt",
        "lastActivityAt",
        "prompts",
        "focus",
        "mode",
        "permissionMode",
        "pid"
      ]
    },
    "SessionText": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SessionText.json",
      "type": "string",
      "maxLength": 500
    },
    "PromptCount": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "PromptCount.json",
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "SessionMode": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SessionMode.json",
      "type": "string",
      "enum": ["Interactive", "Headless", "Unknown"]
    },
    "UsageDelta": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "UsageDelta.json",
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "host": {
          "$ref": "SessionText.json",
          "minLength": 1
        },
        "repo": {
          "$ref": "SessionText.json"
        },
        "provider": {
          "$ref": "SessionText.json",
          "minLength": 1
        },
        "account": {
          "$ref": "SessionText.json",
          "minLength": 1
        },
        "model": {
          "$ref": "SessionText.json",
          "minLength": 1
        },
        "prompts": {
          "$ref": "PromptCount.json"
        },
        "inputTokens": {
          "$ref": "TokenCount.json"
        },
        "outputTokens": {
          "$ref": "TokenCount.json"
        },
        "cacheWriteTokens": {
          "$ref": "TokenCount.json"
        },
        "cacheReadTokens": {
          "$ref": "TokenCount.json"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "durable": {
          "type": "boolean"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 500
        }
      },
      "required": [
        "seq",
        "host",
        "repo",
        "provider",
        "account",
        "model",
        "prompts",
        "inputTokens",
        "outputTokens",
        "cacheWriteTokens",
        "cacheReadTokens",
        "at",
        "durable",
        "files"
      ]
    },
    "TokenCount": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "TokenCount.json",
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "Device": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "Device.json",
      "type": "object",
      "properties": {
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "$ref": "SessionText.json"
        },
        "host": {
          "$ref": "SessionText.json",
          "minLength": 1
        },
        "hostLabel": {
          "$ref": "SessionText.json",
          "minLength": 1
        },
        "createdAt": {
          "type": "integer"
        },
        "lastUsedAt": {
          "type": "integer"
        },
        "current": {
          "type": "boolean"
        }
      },
      "required": ["deviceId", "name", "host", "hostLabel", "createdAt", "lastUsedAt", "current"]
    },
    "Session": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "Session.json",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "$ref": "SessionText.json"
        },
        "agentName": {
          "$ref": "SessionText.json"
        },
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "$ref": "SessionText.json"
        },
        "hostLabel": {
          "$ref": "SessionText.json"
        },
        "cwd": {
          "$ref": "SessionText.json"
        },
        "repo": {
          "$ref": "SessionText.json"
        },
        "branch": {
          "$ref": "SessionText.json"
        },
        "commit": {
          "$ref": "SessionText.json"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastActivityAt": {
          "type": "string",
          "format": "date-time"
        },
        "prompts": {
          "$ref": "PromptCount.json"
        },
        "focus": {
          "$ref": "SessionFocus.json"
        },
        "mode": {
          "$ref": "SessionMode.json"
        },
        "permissionMode": {
          "$ref": "SessionText.json"
        },
        "pid": {
          "type": "integer",
          "minimum": 0
        },
        "current": {
          "type": "boolean"
        }
      },
      "required": [
        "sessionId",
        "name",
        "agentName",
        "deviceId",
        "host",
        "hostLabel",
        "cwd",
        "repo",
        "branch",
        "commit",
        "startedAt",
        "lastActivityAt",
        "prompts",
        "focus",
        "mode",
        "permissionMode",
        "pid",
        "current"
      ]
    },
    "PastSession": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "PastSession.json",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "$ref": "SessionText.json"
        },
        "agentName": {
          "$ref": "SessionText.json"
        },
        "host": {
          "$ref": "SessionText.json"
        },
        "hostLabel": {
          "$ref": "SessionText.json"
        },
        "cwd": {
          "$ref": "SessionText.json"
        },
        "repo": {
          "$ref": "SessionText.json"
        },
        "branch": {
          "$ref": "SessionText.json"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastActivityAt": {
          "type": "string",
          "format": "date-time"
        },
        "prompts": {
          "$ref": "PromptCount.json"
        },
        "focus": {
          "$ref": "SessionFocus.json"
        },
        "running": {
          "type": "boolean"
        }
      },
      "required": [
        "sessionId",
        "name",
        "agentName",
        "host",
        "hostLabel",
        "cwd",
        "repo",
        "branch",
        "startedAt",
        "lastActivityAt",
        "prompts",
        "focus",
        "running"
      ]
    },
    "SessionExcerpt": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SessionExcerpt.json",
      "type": "object",
      "properties": {
        "speaker": {
          "anyOf": [
            {
              "type": "string",
              "const": "user"
            },
            {
              "type": "string",
              "const": "model"
            }
          ]
        },
        "text": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["speaker", "text", "at"]
    },
    "SessionHit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SessionHit.json",
      "type": "object",
      "properties": {
        "session": {
          "$ref": "PastSession.json"
        },
        "score": {
          "type": "number"
        },
        "excerpt": {
          "$ref": "SessionExcerpt.json"
        }
      },
      "required": ["session", "score", "excerpt"]
    },
    "Peek": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "Peek.json",
      "type": "object",
      "properties": {
        "peekId": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "PeekState.json"
        },
        "digest": {
          "$ref": "PeekDigest.json"
        },
        "requestedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["peekId", "state", "digest", "requestedAt"],
      "description": "One peek a session was asked for. A request is `Pending` and carries no digest; the host's\nsummariser answers it and the peek reads `Ready`. A session that never answers leaves the request\npending until the history drops it."
    },
    "PeekState": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "PeekState.json",
      "type": "string",
      "enum": ["Pending", "Ready"]
    },
    "PeekDigest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "PeekDigest.json",
      "type": "string",
      "maxLength": 2000,
      "description": "What one session was doing when it was peeked at, in a few sentences. A summariser on that\nsession's host writes it from the tail of the transcript, so the session's own context never\ncarries it."
    },
    "WritePeek": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "WritePeek.json",
      "type": "object",
      "properties": {
        "digest": {
          "$ref": "PeekDigest.json"
        }
      },
      "required": ["digest"],
      "description": "What a summariser puts back on the peek it was handed."
    },
    "PeekHistory": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "PeekHistory.json",
      "type": "object",
      "properties": {
        "peeks": {
          "type": "array",
          "items": {
            "$ref": "Peek.json"
          },
          "maxItems": 20
        }
      },
      "required": ["peeks"],
      "description": "The peeks one session holds, newest first. A new peek drops the oldest past the twentieth."
    },
    "MessageAddress": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "MessageAddress.json",
      "type": "object",
      "properties": {
        "scope": {
          "anyOf": [
            {
              "type": "string",
              "const": "host"
            },
            {
              "type": "string",
              "const": "session"
            }
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["scope", "target"]
    },
    "SendMessage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SendMessage.json",
      "type": "object",
      "properties": {
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "const": "news"
            },
            {
              "type": "string",
              "const": "order"
            }
          ]
        },
        "address": {
          "$ref": "MessageAddress.json"
        },
        "fromSessionId": {
          "type": "string"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        }
      },
      "required": ["kind", "address", "fromSessionId", "body"]
    },
    "MemoryPath": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "MemoryPath.json",
      "type": "object",
      "properties": {
        "memoryName": {
          "$ref": "MemoryName.json"
        }
      },
      "required": ["memoryName"]
    },
    "MemoryName": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "MemoryName.json",
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "Memory": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "Memory.json",
      "type": "object",
      "properties": {
        "memoryId": {
          "type": "string",
          "minLength": 1
        },
        "memoryName": {
          "$ref": "MemoryName.json"
        },
        "description": {
          "$ref": "MemoryDescription.json"
        },
        "type": {
          "$ref": "MemoryType.json"
        },
        "body": {
          "$ref": "MemoryBody.json"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "MemoryTag.json"
          },
          "maxItems": 50
        },
        "createdAt": {
          "type": "integer"
        },
        "updatedAt": {
          "type": "integer"
        },
        "recallCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "memoryId",
        "memoryName",
        "description",
        "type",
        "body",
        "tags",
        "createdAt",
        "updatedAt",
        "recallCount"
      ]
    },
    "MemoryDescription": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "MemoryDescription.json",
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "MemoryType": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "MemoryType.json",
      "type": "string",
      "enum": ["User", "Feedback", "Project", "Reference"]
    },
    "MemoryBody": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "MemoryBody.json",
      "type": "string",
      "maxLength": 100000
    },
    "MemoryTag": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "MemoryTag.json",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[a-z0-9][a-z0-9._:/-]*$"
    },
    "SaveMemory": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SaveMemory.json",
      "type": "object",
      "properties": {
        "description": {
          "$ref": "MemoryDescription.json"
        },
        "type": {
          "$ref": "MemoryType.json"
        },
        "body": {
          "$ref": "MemoryBody.json"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "MemoryTag.json"
          },
          "maxItems": 50
        }
      },
      "required": ["description", "type", "body", "tags"]
    },
    "ListMemories": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ListMemories.json",
      "type": "object",
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "$ref": "MemoryTag.json"
          },
          "maxItems": 50
        },
        "type": {
          "type": "array",
          "items": {
            "$ref": "MemoryType.json"
          }
        },
        "since": {
          "type": "string",
          "format": "date-time"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "type": "string"
        }
      },
      "required": ["tags", "type", "since", "limit", "cursor"]
    },
    "SearchMemories": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SearchMemories.json",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "scope": {
          "type": "array",
          "items": {
            "$ref": "MemoryTag.json"
          },
          "maxItems": 50,
          "description": "Narrows the search to memories carrying one of these tags. An empty list searches every memory."
        },
        "preferScope": {
          "type": "array",
          "items": {
            "$ref": "MemoryTag.json"
          },
          "maxItems": 50,
          "description": "Ranks memories carrying one of these tags above the rest, score settling each group. An empty list ranks on score alone."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "minScore": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "mode": {
          "$ref": "SearchMode.json"
        }
      },
      "required": ["query", "scope", "preferScope", "limit", "minScore", "mode"],
      "description": "What a deliberate search asks for. Breadth is the default: an empty `scope` searches every\nmemory this account holds. `preferScope` is a sort key and never a filter, so a memory from\nanother repo that answers the query well is ranked below the ones from here rather than dropped."
    },
    "SearchMode": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SearchMode.json",
      "type": "string",
      "enum": ["Hybrid", "Vector", "Text"]
    },
    "MemoryHit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "MemoryHit.json",
      "type": "object",
      "properties": {
        "memory": {
          "$ref": "Memory.json"
        },
        "score": {
          "type": "number"
        },
        "inScope": {
          "type": "boolean",
          "description": "Whether this memory carries one of the tags `preferScope` named."
        }
      },
      "required": ["memory", "score", "inScope"]
    },
    "ScopeCount": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ScopeCount.json",
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "MemoryTag.json"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": ["scope", "count"],
      "description": "One scope the match set holds, and how many of the matches carry it."
    },
    "SearchResults": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SearchResults.json",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "MemoryHit.json"
          },
          "maxItems": 25
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "ScopeCount.json"
          }
        }
      },
      "required": ["count", "results", "scopes"],
      "description": "What a search answers with. `count` and `scopes` cover the whole match set; `results` is the\nfirst page of it, ranked. A caller reading a `count` in the hundreds narrows with a `scope` the\n`scopes` list named rather than paging blind."
    },
    "InjectMemories": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "InjectMemories.json",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "preferScope": {
          "type": "array",
          "items": {
            "$ref": "MemoryTag.json"
          },
          "maxItems": 50
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "minScore": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "The cosine similarity a memory must reach to count as a match. It bounds the work and not just\nthe answer: every match has its scope read whether or not it is shown, so a floor near zero\nreads the tags of the whole corpus to put at most ten memories in front of a prompt. `limit`\nbounds what comes back, never what is read."
        }
      },
      "required": ["query", "preferScope", "limit", "minScore"],
      "description": "What the prompt hook asks for on every prompt. It searches every memory and never filters:\n`preferScope` carries where the caller is, and ranks those memories above the rest."
    },
    "InjectedMemory": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "InjectedMemory.json",
      "type": "object",
      "properties": {
        "score": {
          "type": "number"
        },
        "memoryName": {
          "$ref": "MemoryName.json"
        },
        "type": {
          "$ref": "MemoryType.json"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "MemoryTag.json"
          },
          "maxItems": 50
        },
        "description": {
          "$ref": "MemoryDescription.json"
        },
        "inScope": {
          "type": "boolean"
        }
      },
      "required": ["score", "memoryName", "type", "tags", "description", "inScope"],
      "description": "One memory worth putting in front of a prompt, without its body: enough to decide whether to read it."
    }
  }
}
