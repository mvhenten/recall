{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recall.json",
  "$defs": {
    "AppendRecords": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "AppendRecords.json",
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "TranscriptLine.json"
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "closed": {
          "type": "boolean",
          "description": "Whether a line break closes the last record this append carries. Records join with one break\nbetween them and a file is the records of it laid out that way, so the break that ends the\nfile is the one thing no ordinal says: a transcript always ends on one, and a tool output the\nsession stopped writing part way through a line does not."
        }
      },
      "required": ["file", "from", "records", "closed"]
    },
    "TranscriptLine": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "TranscriptLine.json",
      "type": "string",
      "minLength": 1,
      "description": "One line of a transcript file, redacted, under the ordinal it holds in that file. A line that is\nnot valid UTF-8 would cross as a JSON string lossily, so it is carried as the marker\n`\\u0000base64:` and the line's own bytes in base64; the archive decodes it back and holds the\nbytes the host read. A line that is valid UTF-8 and opens with that marker is carried the same\nway, which is what makes reading one unambiguous."
    },
    "RecordsAccepted": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RecordsAccepted.json",
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "next": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": ["file", "next"]
    },
    "RecordsConflict": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RecordsConflict.json",
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "minLength": 1
        },
        "next": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": ["error", "next"]
    },
    "SessionFocus": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SessionFocus.json",
      "type": "object",
      "properties": {
        "first": {
          "$ref": "FocusText.json"
        },
        "latest": {
          "$ref": "FocusText.json"
        }
      },
      "required": ["first", "latest"]
    },
    "FocusText": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "FocusText.json",
      "type": "string",
      "maxLength": 200
    },
    "SessionSync": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SessionSync.json",
      "type": "object",
      "properties": {
        "host": {
          "$ref": "SessionText.json",
          "minLength": 1
        },
        "cwd": {
          "$ref": "SessionText.json"
        },
        "repo": {
          "$ref": "SessionText.json"
        },
        "branch": {
          "$ref": "SessionText.json"
        },
        "commit": {
          "$ref": "SessionText.json"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastActivityAt": {
          "type": "string",
          "format": "date-time"
        },
        "prompts": {
          "$ref": "PromptCount.json"
        },
        "focus": {
          "$ref": "SessionFocus.json"
        },
        "mode": {
          "$ref": "SessionMode.json"
        },
        "permissionMode": {
          "$ref": "SessionText.json"
        },
        "pid": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "host",
        "cwd",
        "repo",
        "branch",
        "commit",
        "startedAt",
        "lastActivityAt",
        "prompts",
        "focus",
        "mode",
        "permissionMode",
        "pid"
      ]
    },
    "SessionText": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SessionText.json",
      "type": "string",
      "maxLength": 500
    },
    "PromptCount": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "PromptCount.json",
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "SessionMode": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SessionMode.json",
      "type": "string",
      "enum": ["Interactive", "Headless", "Unknown"]
    },
    "UsageDelta": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "UsageDelta.json",
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "host": {
          "$ref": "SessionText.json",
          "minLength": 1
        },
        "repo": {
          "$ref": "SessionText.json"
        },
        "provider": {
          "$ref": "SessionText.json",
          "minLength": 1
        },
        "account": {
          "$ref": "SessionText.json",
          "minLength": 1
        },
        "model": {
          "$ref": "SessionText.json",
          "minLength": 1
        },
        "prompts": {
          "$ref": "PromptCount.json"
        },
        "inputTokens": {
          "$ref": "TokenCount.json"
        },
        "outputTokens": {
          "$ref": "TokenCount.json"
        },
        "cacheWriteTokens": {
          "$ref": "TokenCount.json"
        },
        "cacheReadTokens": {
          "$ref": "TokenCount.json"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "durable": {
          "type": "boolean"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 500
        }
      },
      "required": [
        "seq",
        "host",
        "repo",
        "provider",
        "account",
        "model",
        "prompts",
        "inputTokens",
        "outputTokens",
        "cacheWriteTokens",
        "cacheReadTokens",
        "at",
        "durable",
        "files"
      ]
    },
    "TokenCount": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "TokenCount.json",
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "Device": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "Device.json",
      "type": "object",
      "properties": {
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "$ref": "SessionText.json"
        },
        "host": {
          "$ref": "SessionText.json",
          "minLength": 1
        },
        "hostLabel": {
          "$ref": "SessionText.json",
          "minLength": 1
        },
        "createdAt": {
          "type": "integer"
        },
        "lastUsedAt": {
          "type": "integer"
        },
        "current": {
          "type": "boolean"
        }
      },
      "required": ["deviceId", "name", "host", "hostLabel", "createdAt", "lastUsedAt", "current"]
    },
    "Session": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "Session.json",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "$ref": "SessionText.json"
        },
        "agentName": {
          "$ref": "SessionText.json"
        },
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "$ref": "SessionText.json"
        },
        "hostLabel": {
          "$ref": "SessionText.json"
        },
        "cwd": {
          "$ref": "SessionText.json"
        },
        "repo": {
          "$ref": "SessionText.json"
        },
        "branch": {
          "$ref": "SessionText.json"
        },
        "commit": {
          "$ref": "SessionText.json"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastActivityAt": {
          "type": "string",
          "format": "date-time"
        },
        "prompts": {
          "$ref": "PromptCount.json"
        },
        "focus": {
          "$ref": "SessionFocus.json"
        },
        "mode": {
          "$ref": "SessionMode.json"
        },
        "permissionMode": {
          "$ref": "SessionText.json"
        },
        "pid": {
          "type": "integer",
          "minimum": 0
        },
        "current": {
          "type": "boolean"
        }
      },
      "required": [
        "sessionId",
        "name",
        "agentName",
        "deviceId",
        "host",
        "hostLabel",
        "cwd",
        "repo",
        "branch",
        "commit",
        "startedAt",
        "lastActivityAt",
        "prompts",
        "focus",
        "mode",
        "permissionMode",
        "pid",
        "current"
      ]
    },
    "PastSession": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "PastSession.json",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "$ref": "SessionText.json"
        },
        "agentName": {
          "$ref": "SessionText.json"
        },
        "host": {
          "$ref": "SessionText.json"
        },
        "hostLabel": {
          "$ref": "SessionText.json"
        },
        "cwd": {
          "$ref": "SessionText.json"
        },
        "repo": {
          "$ref": "SessionText.json"
        },
        "branch": {
          "$ref": "SessionText.json"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastActivityAt": {
          "type": "string",
          "format": "date-time"
        },
        "prompts": {
          "$ref": "PromptCount.json"
        },
        "focus": {
          "$ref": "SessionFocus.json"
        },
        "running": {
          "type": "boolean"
        }
      },
      "required": [
        "sessionId",
        "name",
        "agentName",
        "host",
        "hostLabel",
        "cwd",
        "repo",
        "branch",
        "startedAt",
        "lastActivityAt",
        "prompts",
        "focus",
        "running"
      ]
    },
    "SessionExcerpt": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SessionExcerpt.json",
      "type": "object",
      "properties": {
        "speaker": {
          "anyOf": [
            {
              "type": "string",
              "const": "user"
            },
            {
              "type": "string",
              "const": "model"
            }
          ]
        },
        "text": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["speaker", "text", "at"]
    },
    "SessionHit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SessionHit.json",
      "type": "object",
      "properties": {
        "session": {
          "$ref": "PastSession.json"
        },
        "score": {
          "type": "number"
        },
        "excerpt": {
          "$ref": "SessionExcerpt.json"
        }
      },
      "required": ["session", "score", "excerpt"]
    },
    "MessageAddress": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "MessageAddress.json",
      "type": "object",
      "properties": {
        "scope": {
          "anyOf": [
            {
              "type": "string",
              "const": "host"
            },
            {
              "type": "string",
              "const": "session"
            }
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["scope", "target"]
    },
    "SendMessage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SendMessage.json",
      "type": "object",
      "properties": {
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "const": "news"
            },
            {
              "type": "string",
              "const": "order"
            }
          ]
        },
        "address": {
          "$ref": "MessageAddress.json"
        },
        "fromSessionId": {
          "type": "string"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        }
      },
      "required": ["kind", "address", "fromSessionId", "body"]
    },
    "MemoryPath": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "MemoryPath.json",
      "type": "object",
      "properties": {
        "memoryName": {
          "$ref": "MemoryName.json"
        }
      },
      "required": ["memoryName"]
    },
    "MemoryName": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "MemoryName.json",
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "Memory": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "Memory.json",
      "type": "object",
      "properties": {
        "memoryId": {
          "type": "string",
          "minLength": 1
        },
        "memoryName": {
          "$ref": "MemoryName.json"
        },
        "description": {
          "$ref": "MemoryDescription.json"
        },
        "type": {
          "$ref": "MemoryType.json"
        },
        "body": {
          "$ref": "MemoryBody.json"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "MemoryTag.json"
          },
          "maxItems": 50
        },
        "createdAt": {
          "type": "integer"
        },
        "updatedAt": {
          "type": "integer"
        },
        "recallCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "memoryId",
        "memoryName",
        "description",
        "type",
        "body",
        "tags",
        "createdAt",
        "updatedAt",
        "recallCount"
      ]
    },
    "MemoryDescription": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "MemoryDescription.json",
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "MemoryType": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "MemoryType.json",
      "type": "string",
      "enum": ["User", "Feedback", "Project", "Reference"]
    },
    "MemoryBody": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "MemoryBody.json",
      "type": "string",
      "maxLength": 100000
    },
    "MemoryTag": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "MemoryTag.json",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[a-z0-9][a-z0-9._:/-]*$"
    },
    "SaveMemory": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SaveMemory.json",
      "type": "object",
      "properties": {
        "description": {
          "$ref": "MemoryDescription.json"
        },
        "type": {
          "$ref": "MemoryType.json"
        },
        "body": {
          "$ref": "MemoryBody.json"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "MemoryTag.json"
          },
          "maxItems": 50
        }
      },
      "required": ["description", "type", "body", "tags"]
    },
    "ListMemories": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ListMemories.json",
      "type": "object",
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "$ref": "MemoryTag.json"
          },
          "maxItems": 50
        },
        "type": {
          "type": "array",
          "items": {
            "$ref": "MemoryType.json"
          }
        },
        "since": {
          "type": "string",
          "format": "date-time"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "type": "string"
        }
      },
      "required": ["tags", "type", "since", "limit", "cursor"]
    },
    "SearchMemories": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SearchMemories.json",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "MemoryTag.json"
          },
          "maxItems": 50
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "minScore": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "mode": {
          "$ref": "SearchMode.json"
        }
      },
      "required": ["query", "tags", "limit", "minScore", "mode"]
    },
    "SearchMode": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SearchMode.json",
      "type": "string",
      "enum": ["Hybrid", "Vector", "Text"]
    },
    "MemoryHit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "MemoryHit.json",
      "type": "object",
      "properties": {
        "memory": {
          "$ref": "Memory.json"
        },
        "score": {
          "type": "number"
        }
      },
      "required": ["memory", "score"]
    },
    "NearbyMemory": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "NearbyMemory.json",
      "type": "object",
      "properties": {
        "score": {
          "type": "number"
        },
        "memoryName": {
          "$ref": "MemoryName.json"
        },
        "type": {
          "$ref": "MemoryType.json"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "MemoryTag.json"
          },
          "maxItems": 50
        },
        "description": {
          "$ref": "MemoryDescription.json"
        }
      },
      "required": ["score", "memoryName", "type", "tags", "description"]
    },
    "CopiedRow": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "CopiedRow.json",
      "type": "object",
      "properties": {
        "rowId": {
          "$ref": "RowId.json"
        },
        "outcome": {
          "$ref": "CopyOutcome.json"
        }
      },
      "required": ["rowId", "outcome"]
    },
    "RowId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RowId.json",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "The id one row of either store is known by: a version 5 uuid over the row written out by\n`src/row-digest.ts`. The copy derives it on the server from the row itself and never takes one\nfrom a caller, so an id is a reading of a row and not a claim about one."
    },
    "CopyOutcome": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "CopyOutcome.json",
      "type": "string",
      "enum": ["Stored", "AlreadyStored", "Blocked"],
      "description": "What became of one row the copy offered the object."
    },
    "CopiedTable": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "CopiedTable.json",
      "type": "object",
      "properties": {
        "table": {
          "$ref": "CopyTable.json"
        },
        "stored": {
          "type": "integer"
        },
        "alreadyStored": {
          "type": "integer"
        },
        "blocked": {
          "type": "integer"
        },
        "blockedIds": {
          "type": "array",
          "items": {
            "$ref": "RowId.json"
          },
          "maxItems": 50
        },
        "collided": {
          "type": "integer",
          "description": "Ids D1's own rows share, which two rows of one table cannot do: every column that identifies a\nrow is written into its id. A repeat is the serialiser collapsing two rows into one id, which\nwould hide a row that never crossed, and is a different fault to a row that did not cross."
        },
        "collidedIds": {
          "type": "array",
          "items": {
            "$ref": "RowId.json"
          },
          "maxItems": 50
        },
        "identity": {
          "$ref": "CopyIdentity.json",
          "description": "What a row of this table was known by, which is what `blocked` means for it."
        },
        "inAccount": {
          "type": "integer"
        },
        "inTenant": {
          "type": "integer"
        }
      },
      "required": [
        "table",
        "stored",
        "alreadyStored",
        "blocked",
        "blockedIds",
        "collided",
        "collidedIds",
        "identity",
        "inAccount",
        "inTenant"
      ],
      "description": "What one table did. `stored` and `alreadyStored` are counted off the answer the object gave for\neach row and nothing else; `blocked` is the rows that did not cross, and `blockedIds` names as\nmany of them as the cap allows so an operator can read them out of D1. The two row counts are\nthere to be looked at and carry nothing: the object writes its own rows into these tables after\nthe cutover, so a table it has outgrown D1 on reads as arrived whether or not a row ever crossed."
    },
    "CopyTable": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "CopyTable.json",
      "type": "string",
      "enum": [
        "Sessions",
        "History",
        "Index",
        "Records",
        "OpenChunks",
        "UsageDaily",
        "Labels",
        "CountedFiles",
        "UsageEvents",
        "BoardMessages",
        "BoardPickups",
        "Chunks"
      ],
      "description": "The tables the move into a tenant's own object left behind in D1, in the order the copy walks them."
    },
    "CopyIdentity": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "CopyIdentity.json",
      "type": "string",
      "enum": ["Key", "WholeRow", "Walked"],
      "description": "What a row of a table is known by, which is what a row that did not cross means."
    },
    "CopySessions": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "CopySessions.json",
      "type": "object",
      "properties": {
        "after": {
          "type": "integer",
          "minimum": 0,
          "description": "Where the walk of the prose opens: the chunk sequence a call of this run answered with."
        },
        "metadataComplete": {
          "type": "boolean",
          "description": "Whether a call of this run has already written every table but the prose. Only a call that\nanswered can say so — the tables are written before a response is built — and no count of the\nobject could stand in for it."
        }
      },
      "required": ["after", "metadataComplete"]
    },
    "IndexSound": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "IndexSound.json",
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "Sound"
        }
      },
      "required": ["state"],
      "description": "A full-text index SQLite read against the rows it indexes and found nothing to say about."
    },
    "IndexCorrupt": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "IndexCorrupt.json",
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "Corrupt"
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["state", "error"],
      "description": "An index and the rows it indexes disagree. The chunks' index is external-content and the copy\nmoves rowids by hand, so an entry left behind at a mover's old key would answer a later query\nwith the chunk that now holds it."
    },
    "IndexUnread": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "IndexUnread.json",
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "Unread"
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["state", "error"],
      "description": "The check did not run, so the index is neither sound nor known to be otherwise. A different thing\nto tell an operator than an index that disagrees with its rows, and a different thing to do about."
    },
    "CopiedChunks": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "CopiedChunks.json",
      "type": "object",
      "properties": {
        "stored": {
          "type": "integer"
        },
        "alreadyStored": {
          "type": "integer"
        },
        "inAccount": {
          "type": "integer"
        },
        "shifted": {
          "type": "integer",
          "description": "Copied chunks that could not keep the ordinal D1 gave them, the object holding that one already."
        },
        "moved": {
          "type": "integer",
          "description": "The object's own chunks moved up the sequence to free a key a copied one came in under."
        },
        "frontier": {
          "type": "integer"
        },
        "done": {
          "type": "boolean"
        }
      },
      "required": ["stored", "alreadyStored", "inAccount", "shifted", "moved", "frontier", "done"]
    },
    "CopyChecks": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "CopyChecks.json",
      "type": "object",
      "properties": {
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extra": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missingChunks": {
          "type": "integer"
        },
        "embeddings": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "chunkIndex": {
          "$ref": "CopyIndexCheck.json"
        },
        "historyIndex": {
          "$ref": "CopyIndexCheck.json"
        },
        "ok": {
          "type": "boolean",
          "description": "What this call can account for, which is everything but how much of the prose the run walked."
        }
      },
      "required": ["missing", "extra", "missingChunks", "embeddings", "chunkIndex", "historyIndex", "ok"]
    },
    "CopyIndexCheck": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "CopyIndexCheck.json",
      "anyOf": [
        {
          "$ref": "IndexSound.json"
        },
        {
          "$ref": "IndexCorrupt.json"
        },
        {
          "$ref": "IndexUnread.json"
        }
      ],
      "description": "What SQLite made of a full-text index against the rows it indexes, or that it never read it."
    },
    "SessionCopy": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SessionCopy.json",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "CopiedTable.json"
          }
        },
        "metadataComplete": {
          "type": "boolean"
        },
        "chunks": {
          "$ref": "CopiedChunks.json"
        },
        "straddling": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checks": {
          "$ref": "CopyChecks.json"
        }
      },
      "required": ["userId", "tables", "metadataComplete", "chunks", "straddling", "checks"]
    }
  }
}
