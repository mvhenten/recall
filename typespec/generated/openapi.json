{
  "openapi": "3.0.0",
  "info": {
    "title": "recall",
    "version": "0.0.0"
  },
  "tags": [],
  "paths": {},
  "components": {
    "schemas": {
      "AppendRecords": {
        "type": "object",
        "required": ["file", "from", "records", "closed"],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TranscriptLine"
            },
            "minItems": 1,
            "maxItems": 1000
          },
          "closed": {
            "type": "boolean",
            "description": "Whether a line break closes the last record this append carries. Records join with one break\nbetween them and a file is the records of it laid out that way, so the break that ends the\nfile is the one thing no ordinal says: a transcript always ends on one, and a tool output the\nsession stopped writing part way through a line does not."
          }
        }
      },
      "CopiedChunks": {
        "type": "object",
        "required": ["stored", "alreadyStored", "inAccount", "shifted", "moved", "frontier", "done"],
        "properties": {
          "stored": {
            "type": "integer",
            "format": "int64"
          },
          "alreadyStored": {
            "type": "integer",
            "format": "int64"
          },
          "inAccount": {
            "type": "integer",
            "format": "int64"
          },
          "shifted": {
            "type": "integer",
            "format": "int64",
            "description": "Copied chunks that could not keep the ordinal D1 gave them, the object holding that one already."
          },
          "moved": {
            "type": "integer",
            "format": "int64",
            "description": "The object's own chunks moved up the sequence to free a key a copied one came in under."
          },
          "frontier": {
            "type": "integer",
            "format": "int64"
          },
          "done": {
            "type": "boolean"
          }
        }
      },
      "CopiedRow": {
        "type": "object",
        "required": ["rowId", "outcome"],
        "properties": {
          "rowId": {
            "$ref": "#/components/schemas/RowId"
          },
          "outcome": {
            "$ref": "#/components/schemas/CopyOutcome"
          }
        }
      },
      "CopiedTable": {
        "type": "object",
        "required": [
          "table",
          "stored",
          "alreadyStored",
          "blocked",
          "blockedIds",
          "collided",
          "collidedIds",
          "identity",
          "inAccount",
          "inTenant"
        ],
        "properties": {
          "table": {
            "$ref": "#/components/schemas/CopyTable"
          },
          "stored": {
            "type": "integer",
            "format": "int64"
          },
          "alreadyStored": {
            "type": "integer",
            "format": "int64"
          },
          "blocked": {
            "type": "integer",
            "format": "int64"
          },
          "blockedIds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RowId"
            },
            "maxItems": 50
          },
          "collided": {
            "type": "integer",
            "format": "int64",
            "description": "Ids D1's own rows share, which two rows of one table cannot do: every column that identifies a\nrow is written into its id. A repeat is the serialiser collapsing two rows into one id, which\nwould hide a row that never crossed, and is a different fault to a row that did not cross."
          },
          "collidedIds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RowId"
            },
            "maxItems": 50
          },
          "identity": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CopyIdentity"
              }
            ],
            "description": "What a row of this table was known by, which is what `blocked` means for it."
          },
          "inAccount": {
            "type": "integer",
            "format": "int64"
          },
          "inTenant": {
            "type": "integer",
            "format": "int64"
          }
        },
        "description": "What one table did. `stored` and `alreadyStored` are counted off the answer the object gave for\neach row and nothing else; `blocked` is the rows that did not cross, and `blockedIds` names as\nmany of them as the cap allows so an operator can read them out of D1. The two row counts are\nthere to be looked at and carry nothing: the object writes its own rows into these tables after\nthe cutover, so a table it has outgrown D1 on reads as arrived whether or not a row ever crossed."
      },
      "CopyChecks": {
        "type": "object",
        "required": ["missing", "extra", "missingChunks", "embeddings", "chunkIndex", "historyIndex", "ok"],
        "properties": {
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "extra": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missingChunks": {
            "type": "integer",
            "format": "int64"
          },
          "embeddings": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "chunkIndex": {
            "$ref": "#/components/schemas/CopyIndexCheck"
          },
          "historyIndex": {
            "$ref": "#/components/schemas/CopyIndexCheck"
          },
          "ok": {
            "type": "boolean",
            "description": "What this call can account for, which is everything but how much of the prose the run walked."
          }
        }
      },
      "CopyIdentity": {
        "type": "string",
        "enum": ["Key", "WholeRow", "Walked"],
        "description": "What a row of a table is known by, which is what a row that did not cross means."
      },
      "CopyIndexCheck": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/IndexSound"
          },
          {
            "$ref": "#/components/schemas/IndexCorrupt"
          },
          {
            "$ref": "#/components/schemas/IndexUnread"
          }
        ],
        "description": "What SQLite made of a full-text index against the rows it indexes, or that it never read it."
      },
      "CopyOutcome": {
        "type": "string",
        "enum": ["Stored", "AlreadyStored", "Blocked"],
        "description": "What became of one row the copy offered the object."
      },
      "CopySessions": {
        "type": "object",
        "required": ["after", "metadataComplete"],
        "properties": {
          "after": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Where the walk of the prose opens: the chunk sequence a call of this run answered with."
          },
          "metadataComplete": {
            "type": "boolean",
            "description": "Whether a call of this run has already written every table but the prose. Only a call that\nanswered can say so — the tables are written before a response is built — and no count of the\nobject could stand in for it."
          }
        }
      },
      "CopyTable": {
        "type": "string",
        "enum": [
          "Sessions",
          "History",
          "Index",
          "Records",
          "OpenChunks",
          "UsageDaily",
          "Labels",
          "CountedFiles",
          "UsageEvents",
          "BoardMessages",
          "BoardPickups",
          "Chunks"
        ],
        "description": "The tables the move into a tenant's own object left behind in D1, in the order the copy walks them."
      },
      "Device": {
        "type": "object",
        "required": ["deviceId", "name", "host", "hostLabel", "createdAt", "lastUsedAt", "current"],
        "properties": {
          "deviceId": {
            "type": "string",
            "minLength": 1
          },
