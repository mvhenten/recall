{
  "openapi": "3.0.0",
  "info": {
    "title": "recall",
    "version": "0.0.0"
  },
  "tags": [],
  "paths": {},
  "components": {
    "schemas": {
      "AppendRecords": {
        "type": "object",
        "required": ["file", "from", "records", "closed"],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TranscriptLine"
            },
            "minItems": 1,
            "maxItems": 1000
          },
          "closed": {
            "type": "boolean",
            "description": "Whether a line break closes the last record this append carries. Records join with one break\nbetween them and a file is the records of it laid out that way, so the break that ends the\nfile is the one thing no ordinal says: a transcript always ends on one, and a tool output the\nsession stopped writing part way through a line does not."
          }
        }
      },
      "Device": {
        "type": "object",
        "required": ["deviceId", "name", "host", "hostLabel", "createdAt", "lastUsedAt", "current"],
        "properties": {
          "deviceId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "$ref": "#/components/schemas/SessionText"
          },
          "host": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionText"
              }
            ],
            "minLength": 1
          },
          "hostLabel": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionText"
              }
            ],
            "minLength": 1
          },
          "createdAt": {
            "type": "integer",
            "format": "int64"
          },
          "lastUsedAt": {
            "type": "integer",
            "format": "int64"
          },
          "current": {
            "type": "boolean"
          }
        }
      },
      "FocusText": {
        "type": "string",
        "maxLength": 200
      },
      "InjectMemories": {
        "type": "object",
        "required": ["query", "preferScope", "limit", "minScore"],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "preferScope": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemoryTag"
            },
            "maxItems": 50
          },
          "limit": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 10
          },
          "minScore": {
            "type": "number",
            "format": "double",
            "minimum": -1,
            "maximum": 1,
            "description": "The cosine similarity a memory must reach to count as a match. It bounds the work and not just\nthe answer: every match has its scope read whether or not it is shown, so a floor near zero\nreads the tags of the whole corpus to put at most ten memories in front of a prompt. `limit`\nbounds what comes back, never what is read."
          }
        },
        "description": "What the prompt hook asks for on every prompt. It searches every memory and never filters:\n`preferScope` carries where the caller is, and ranks those memories above the rest."
      },
      "InjectedMemory": {
        "type": "object",
        "required": ["score", "memoryName", "type", "tags", "description", "inScope"],
        "properties": {
          "score": {
            "type": "number",
            "format": "double"
          },
          "memoryName": {
            "$ref": "#/components/schemas/MemoryName"
          },
          "type": {
            "$ref": "#/components/schemas/MemoryType"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemoryTag"
            },
            "maxItems": 50
          },
          "description": {
            "$ref": "#/components/schemas/MemoryDescription"
          },
          "inScope": {
            "type": "boolean"
          }
        },
        "description": "One memory worth putting in front of a prompt, without its body: enough to decide whether to read it."
      },
      "ListMemories": {
        "type": "object",
        "required": ["tags", "type", "since", "limit", "cursor"],
        "properties": {
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemoryTag"
            },
            "maxItems": 50
          },
          "type": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemoryType"
            }
          },
          "since": {
            "type": "string",
            "format": "date-time"
          },
          "limit": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "Memory": {
        "type": "object",
        "required": [
          "memoryId",
          "memoryName",
          "description",
          "type",
          "body",
          "tags",
          "createdAt",
          "updatedAt",
          "recallCount"
        ],
        "properties": {
          "memoryId": {
            "type": "string",
            "minLength": 1
          },
          "memoryName": {
            "$ref": "#/components/schemas/MemoryName"
          },
          "description": {
            "$ref": "#/components/schemas/MemoryDescription"
          },
          "type": {
            "$ref": "#/components/schemas/MemoryType"
          },
          "body": {
            "$ref": "#/components/schemas/MemoryBody"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemoryTag"
            },
            "maxItems": 50
          },
          "createdAt": {
            "type": "integer",
            "format": "int64"
          },
          "updatedAt": {
            "type": "integer",
            "format": "int64"
          },
          "recallCount": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "MemoryBody": {
        "type": "string",
        "maxLength": 100000
      },
      "MemoryDescription": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "MemoryHit": {
        "type": "object",
        "required": ["memory", "score", "inScope"],
        "properties": {
          "memory": {
            "$ref": "#/components/schemas/Memory"
          },
          "score": {
            "type": "number",
            "format": "double"
          },
          "inScope": {
            "type": "boolean",
            "description": "Whether this memory carries one of the tags `preferScope` named."
          }
        }
      },
      "MemoryName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "MemoryPath": {
        "type": "object",
        "required": ["memoryName"],
        "properties": {
          "memoryName": {
            "$ref": "#/components/schemas/MemoryName"
          }
        }
      },
      "MemoryTag": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[a-z0-9][a-z0-9._:/-]*$"
      },
      "MemoryType": {
        "type": "string",
        "enum": ["User", "Feedback", "Project", "Reference"]
      },
      "MessageAddress": {
        "type": "object",
        "required": ["scope", "target"],
        "properties": {
          "scope": {
            "type": "string",
            "enum": ["host", "session"]
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "PastSession": {
        "type": "object",
        "required": [
          "sessionId",
          "name",
          "agentName",
          "label",
          "host",
          "hostLabel",
          "cwd",
          "repo",
          "branch",
          "startedAt",
          "lastActivityAt",
          "prompts",
          "focus",
          "running"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "$ref": "#/components/schemas/SessionText"
          },
          "agentName": {
            "$ref": "#/components/schemas/SessionText"
          },
          "label": {
            "$ref": "#/components/schemas/SessionText"
          },
          "host": {
            "$ref": "#/components/schemas/SessionText"
          },
          "hostLabel": {
            "$ref": "#/components/schemas/SessionText"
          },
          "cwd": {
            "$ref": "#/components/schemas/SessionText"
          },
          "repo": {
            "$ref": "#/components/schemas/SessionText"
          },
          "branch": {
            "$ref": "#/components/schemas/SessionText"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastActivityAt": {
            "type": "string",
            "format": "date-time"
          },
          "prompts": {
            "$ref": "#/components/schemas/PromptCount"
          },
          "focus": {
            "$ref": "#/components/schemas/SessionFocus"
          },
          "running": {
            "type": "boolean"
          }
        }
      },
      "Peek": {
        "type": "object",
        "required": ["peekId", "state", "digest", "requestedAt"],
        "properties": {
          "peekId": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "$ref": "#/components/schemas/PeekState"
          },
          "digest": {
            "$ref": "#/components/schemas/PeekDigest"
          },
          "requestedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "One peek a session was asked for. A request is `Pending` and carries no digest; the host's\nsummariser answers it and the peek reads `Ready`. A session that never answers leaves the request\npending until the history drops it. The state is the digest read as one of two words, so the two\ncan never disagree."
      },
      "PeekDigest": {
        "type": "string",
        "maxLength": 2000,
        "description": "What one session was doing when it was peeked at, in a few sentences. A summariser on that\nsession's host writes it from the tail of the transcript, so the session's own context never\ncarries it."
      },
      "PeekState": {
        "type": "string",
        "enum": ["Pending", "Ready"]
      },
      "PromptCount": {
        "type": "integer",
        "format": "int32",
        "minimum": 0,
        "maximum": 1000000
      },
      "RecordsAccepted": {
        "type": "object",
        "required": ["file", "next"],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "next": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "RecordsConflict": {
        "type": "object",
        "required": ["error", "next"],
        "properties": {
          "error": {
            "type": "string",
            "minLength": 1
          },
          "next": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "SaveMemory": {
        "type": "object",
        "required": ["description", "type", "body", "tags"],
        "properties": {
          "description": {
            "$ref": "#/components/schemas/MemoryDescription"
          },
          "type": {
            "$ref": "#/components/schemas/MemoryType"
          },
          "body": {
            "$ref": "#/components/schemas/MemoryBody"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemoryTag"
            },
            "maxItems": 50
          }
        }
      },
      "ScopeCount": {
        "type": "object",
        "required": ["scope", "count"],
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/MemoryTag"
          },
          "count": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          }
        },
        "description": "One scope the match set holds, and how many of the matches carry it."
      },
      "SearchMemories": {
        "type": "object",
        "required": ["query", "scope", "preferScope", "limit", "minScore", "mode"],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "scope": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemoryTag"
            },
            "maxItems": 50,
            "description": "Narrows the search to memories carrying one of these tags. An empty list searches every memory."
          },
          "preferScope": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemoryTag"
            },
            "maxItems": 50,
            "description": "Ranks memories carrying one of these tags above the rest, score settling each group. An empty list ranks on score alone."
          },
          "limit": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 25
          },
          "minScore": {
            "type": "number",
            "format": "double",
            "minimum": -1,
            "maximum": 1
          },
          "mode": {
            "$ref": "#/components/schemas/SearchMode"
          }
        },
        "description": "What a deliberate search asks for. Breadth is the default: an empty `scope` searches every\nmemory this account holds. `preferScope` is a sort key and never a filter, so a memory from\nanother repo that answers the query well is ranked below the ones from here rather than dropped."
      },
      "SearchMode": {
        "type": "string",
        "enum": ["Hybrid", "Vector", "Text"]
      },
      "SearchResults": {
        "type": "object",
        "required": ["count", "results", "scopes"],
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemoryHit"
            },
            "maxItems": 25
          },
          "scopes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScopeCount"
            }
          }
        },
        "description": "What a search answers with. `count` and `scopes` cover the whole match set; `results` is the\nfirst page of it, ranked. A caller reading a `count` in the hundreds narrows with a `scope` the\n`scopes` list named rather than paging blind."
      },
      "SendMessage": {
        "type": "object",
        "required": ["kind", "address", "fromSessionId", "body"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["news", "order"]
          },
          "address": {
            "$ref": "#/components/schemas/MessageAddress"
          },
          "fromSessionId": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "sessionId",
          "name",
          "agentName",
          "label",
          "deviceId",
          "host",
          "hostLabel",
          "cwd",
          "repo",
          "branch",
          "commit",
          "startedAt",
          "lastActivityAt",
          "prompts",
          "focus",
          "mode",
          "permissionMode",
          "pid",
          "current"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "$ref": "#/components/schemas/SessionText"
          },
          "agentName": {
            "$ref": "#/components/schemas/SessionText"
          },
          "label": {
            "$ref": "#/components/schemas/SessionText"
          },
          "deviceId": {
            "type": "string",
            "minLength": 1
          },
          "host": {
            "$ref": "#/components/schemas/SessionText"
          },
          "hostLabel": {
            "$ref": "#/components/schemas/SessionText"
          },
          "cwd": {
            "$ref": "#/components/schemas/SessionText"
          },
          "repo": {
            "$ref": "#/components/schemas/SessionText"
          },
          "branch": {
            "$ref": "#/components/schemas/SessionText"
          },
          "commit": {
            "$ref": "#/components/schemas/SessionText"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastActivityAt": {
            "type": "string",
            "format": "date-time"
          },
          "prompts": {
            "$ref": "#/components/schemas/PromptCount"
          },
          "focus": {
            "$ref": "#/components/schemas/SessionFocus"
          },
          "mode": {
            "$ref": "#/components/schemas/SessionMode"
          },
          "permissionMode": {
            "$ref": "#/components/schemas/SessionText"
          },
          "pid": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "current": {
            "type": "boolean"
          }
        }
      },
      "SessionExcerpt": {
        "type": "object",
        "required": ["speaker", "text", "at"],
        "properties": {
          "speaker": {
            "type": "string",
            "enum": ["user", "model"]
          },
          "text": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SessionFocus": {
        "type": "object",
        "required": ["first", "latest"],
        "properties": {
          "first": {
            "$ref": "#/components/schemas/FocusText"
          },
          "latest": {
            "$ref": "#/components/schemas/FocusText"
          }
        }
      },
      "SessionHit": {
        "type": "object",
        "required": ["session", "score", "excerpt"],
        "properties": {
          "session": {
            "$ref": "#/components/schemas/PastSession"
          },
          "score": {
            "type": "number",
            "format": "double"
          },
          "excerpt": {
            "$ref": "#/components/schemas/SessionExcerpt"
          }
        }
      },
      "SessionMode": {
        "type": "string",
        "enum": ["Interactive", "Headless", "Unknown"]
      },
      "SessionSync": {
        "type": "object",
        "required": [
          "host",
          "cwd",
          "repo",
          "branch",
          "commit",
          "startedAt",
          "lastActivityAt",
          "prompts",
          "focus",
          "mode",
          "permissionMode",
          "pid"
        ],
        "properties": {
          "host": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionText"
              }
            ],
            "minLength": 1
          },
          "cwd": {
            "$ref": "#/components/schemas/SessionText"
          },
          "repo": {
            "$ref": "#/components/schemas/SessionText"
          },
          "branch": {
            "$ref": "#/components/schemas/SessionText"
          },
          "commit": {
            "$ref": "#/components/schemas/SessionText"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastActivityAt": {
            "type": "string",
            "format": "date-time"
          },
          "prompts": {
            "$ref": "#/components/schemas/PromptCount"
          },
          "focus": {
            "$ref": "#/components/schemas/SessionFocus"
          },
          "mode": {
            "$ref": "#/components/schemas/SessionMode"
          },
          "permissionMode": {
            "$ref": "#/components/schemas/SessionText"
          },
          "pid": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "SessionText": {
        "type": "string",
        "maxLength": 500
      },
      "TokenCount": {
        "type": "integer",
        "format": "int64",
        "minimum": 0,
        "maximum": 1000000000
      },
      "TranscriptLine": {
        "type": "string",
        "minLength": 1,
        "description": "One line of a transcript file, redacted, under the ordinal it holds in that file. A line that is\nnot valid UTF-8 would cross as a JSON string lossily, so it is carried as the marker\n`\\u0000base64:` and the line's own bytes in base64; the archive decodes it back and holds the\nbytes the host read. A line that is valid UTF-8 and opens with that marker is carried the same\nway, which is what makes reading one unambiguous."
      },
      "UsageDelta": {
        "type": "object",
        "required": [
          "seq",
          "host",
          "repo",
          "provider",
          "account",
          "model",
          "prompts",
          "inputTokens",
          "outputTokens",
          "cacheWriteTokens",
          "cacheReadTokens",
          "at",
          "durable",
          "files"
        ],
        "properties": {
          "seq": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "host": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionText"
              }
            ],
            "minLength": 1
          },
          "repo": {
            "$ref": "#/components/schemas/SessionText"
          },
          "provider": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionText"
              }
            ],
            "minLength": 1
          },
          "account": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionText"
              }
            ],
            "minLength": 1
          },
          "model": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionText"
              }
            ],
            "minLength": 1
          },
          "prompts": {
            "$ref": "#/components/schemas/PromptCount"
          },
          "inputTokens": {
            "$ref": "#/components/schemas/TokenCount"
          },
          "outputTokens": {
            "$ref": "#/components/schemas/TokenCount"
          },
          "cacheWriteTokens": {
            "$ref": "#/components/schemas/TokenCount"
          },
          "cacheReadTokens": {
            "$ref": "#/components/schemas/TokenCount"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "durable": {
            "type": "boolean"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 500
          }
        }
      },
      "WriteLabel": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": {
            "$ref": "#/components/schemas/SessionText"
          }
        },
        "description": "The name its owner gives one session, which every listing prints over the name Claude Code gave\nit. A label of no characters clears the one on record, exactly as an emptied field on the Labels\ntab clears a host's."
      },
      "WritePeek": {
        "type": "object",
        "required": ["digest"],
        "properties": {
          "digest": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PeekDigest"
              }
            ],
            "minLength": 1
          }
        },
        "description": "What a summariser puts back on the peek it was handed. A digest of no characters is what a\npending peek already holds, so one is refused rather than taken for an answer."
      }
    }
  }
}
