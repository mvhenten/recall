          "createdAt": {
            "type": "integer",
            "format": "int64"
          },
          "lastUsedAt": {
            "type": "integer",
            "format": "int64"
          },
          "current": {
            "type": "boolean"
          }
        }
      },
      "FocusText": {
        "type": "string",
        "maxLength": 200
      },
      "IndexCorrupt": {
        "type": "object",
        "required": ["state", "error"],
        "properties": {
          "state": {
            "type": "string",
            "enum": ["Corrupt"]
          },
          "error": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": "An index and the rows it indexes disagree. The chunks' index is external-content and the copy\nmoves rowids by hand, so an entry left behind at a mover's old key would answer a later query\nwith the chunk that now holds it."
      },
      "IndexSound": {
        "type": "object",
        "required": ["state"],
        "properties": {
          "state": {
            "type": "string",
            "enum": ["Sound"]
          }
        },
        "description": "A full-text index SQLite read against the rows it indexes and found nothing to say about."
      },
      "IndexUnread": {
        "type": "object",
        "required": ["state", "error"],
        "properties": {
          "state": {
            "type": "string",
            "enum": ["Unread"]
          },
          "error": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": "The check did not run, so the index is neither sound nor known to be otherwise. A different thing\nto tell an operator than an index that disagrees with its rows, and a different thing to do about."
      },
      "ListMemories": {
